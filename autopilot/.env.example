# ---------------------------------------------------------------------------
# Autopilot for Small Trades — environment
# Copy to .env. Every integration section is optional: with no keys the app
# runs in dry-run mode (texts and payments are logged, not sent).
# ---------------------------------------------------------------------------

# Core
DATABASE_URL=postgresql://user:pass@host:5432/autopilot
SECRET_KEY=generate-a-long-random-string
PUBLIC_BASE_URL=https://autopilot-production.up.railway.app
ENVIRONMENT=production
DEMO_MODE=false
AUTO_SEED_DEMO=0

# Texting (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+14185550123
VERIFY_TWILIO_SIGNATURE=true

# Voice (Vapi)
VAPI_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Sent as the x-vapi-secret header; also stored on the assistant.
VAPI_WEBHOOK_SECRET=change-me

# Payments (Stripe)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUBSCRIPTION_PRICE_ID=price_starter
STRIPE_SUBSCRIPTION_PRICE_ID_PRO=price_pro

# Scheduler
# In-process loop is fine for a single Railway replica. With more than one
# replica, turn this off and use Railway cron -> POST /internal/run-scheduler.
ENABLE_SCHEDULER=false
SCHEDULER_INTERVAL_SECONDS=300
CRON_SECRET=change-me-too
